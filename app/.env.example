# Supabase 제보 전송용. 이 파일을 복사해 .env.local 로 이름을 바꾸고 값을 채운다 (.env.local 은 GitHub에 올라가지 않는다).
# 값 위치: Supabase 대시보드 → Project Settings → API (또는 Data API / API Keys)
# 배포할 때는 Vercel → 프로젝트 → Settings → Environment Variables 에 같은 이름으로 넣는다.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 공개 키(anon 또는 publishable). service_role·secret 키는 절대 넣지 않는다
VITE_SUPABASE_ANON_KEY=
