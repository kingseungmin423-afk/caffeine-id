    { "app": "초콜릿", "category": ["디저트"], "name": "시럽|스프레드" },
    { "app": "과자류", "category": ["디저트", "빵", "시리얼"] },
    { "app": "초콜릿", "category": ["초콜릿", "코코아"] },
    { "app": "약", "category": ["의약품"] }
  ]
